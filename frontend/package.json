{
  "name": "defibar-frontend",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "concurrently \"graphql-codegen --watch --config ./.graphqlrc.yml\" \"next dev --webpack -p 4600\"",
    "build": "npm run types:generate && next build --webpack",
    "types:generate": "graphql-codegen --config .graphqlrc.yml",
    "start-local": "python3 -m http.server 4600 --directory out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@apollo/client": "4.3.7",
    "graphql": "16.15.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@svgr/webpack": "8.1.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    }
  }
}
