{
  "name": "nest-typescript-starter",
  "private": true,
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "license": "MIT",
  "engines": {
    "node": "24.21.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "generate:typings": "ts-node ./src/generateTypings",
    "update:protocols": "node dist/scripts/makeProtocolDb.js",
    "test:updater": "npm run build && node --test test/updater.test.cjs",
    "test": "npm run build && node --test test/unit.test.cjs",
    "test:integration": "npm run build && node --test test/integration.test.cjs"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.0.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "dotenv": "^17.0.0",
    "graphql": "^16.11.0",
    "mongoose": "^9.0.0",
    "nestjs-pino": "^5.0.0",
    "node-fetch": "^2.7.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.0",
    "ts-morph": "^28.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^6.0.0"
  }
}
